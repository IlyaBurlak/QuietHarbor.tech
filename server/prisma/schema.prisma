generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum UserStatus {
  active
  blocked
}

enum BirthdayVisibility {
  all
  friends
  nobody
}

enum AuthProvider {
  telegram
  google
  github
}

enum ResetStatus {
  new
  done
  rejected
}

enum WishlistVisibility {
  private
  link
  friends
}

enum WishlistSort {
  manual
  priority
  price
}

enum ReservationStatus {
  reserved
  bought
}

enum FriendshipStatus {
  pending
  accepted
}

enum GroupStatus {
  open
  drawn
}

model User {
  id                 String             @id @default(cuid())
  username           String?            @unique
  passwordHash       String?
  firstName          String
  lastName           String
  fullName           String
  role               Role               @default(user)
  status             UserStatus         @default(active)
  blockedAt          DateTime?
  blockedReason      String?
  blockedById        String?
  lastLoginAt        DateTime?
  avatarKey          String?
  birthDate          DateTime?          @db.Date
  hideBirthYear      Boolean            @default(false)
  birthdayVisibility BirthdayVisibility @default(friends)
  bio                String?
  usernameChangedAt  DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  sessions            Session[]
  identities          AuthIdentity[]
  wishlists           Wishlist[]
  reservations        Reservation[]
  sentFriendships     Friendship[]           @relation("Requester")
  receivedFriendships Friendship[]           @relation("Addressee")
  ownedGroups         Group[]
  memberships         GroupMember[]
  givenAssignments    Assignment[]           @relation("Giver")
  receivedAssignments Assignment[]           @relation("Receiver")
  resetRequests       PasswordResetRequest[] @relation("ResetTarget")
  handledResets       PasswordResetRequest[] @relation("ResetHandler")
  auditAsAdmin        AdminAuditLog[]        @relation("AuditAdmin")
  auditAsTarget       AdminAuditLog[]        @relation("AuditTarget")
}

model AuthIdentity {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model PasswordResetRequest {
  id             String      @id @default(cuid())
  username       String
  userId         String?
  contact        String
  comment        String?
  requestCode    String      @unique
  status         ResetStatus @default(new)
  handledById    String?
  handledAt      DateTime?
  tokenHash      String?     @unique
  tokenExpiresAt DateTime?
  tokenUsedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user      User? @relation("ResetTarget", fields: [userId], references: [id], onDelete: SetNull)
  handledBy User? @relation("ResetHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  adminId      String
  action       String
  targetUserId String?
  meta         Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  admin  User  @relation("AuditAdmin", fields: [adminId], references: [id])
  target User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminId])
}

model Wishlist {
  id          String             @id @default(cuid())
  ownerId     String
  title       String
  description String?
  visibility  WishlistVisibility @default(private)
  sortMode    WishlistSort       @default(manual)
  shareSlug   String             @unique
  eventDate   DateTime?          @db.Date
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items        Item[]
  groupMembers GroupMember[]

  @@index([ownerId])
}

model Item {
  id          String   @id @default(cuid())
  wishlistId  String
  title       String
  description String?
  price       Decimal? @db.Decimal(12, 2)
  currency    String?  @default("RUB")
  url         String?
  priority    Int      @default(2)
  note        String?
  position    Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wishlist    Wishlist     @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  images      ItemImage[]
  links       ItemLink[]
  reservation Reservation?

  @@index([wishlistId, position])
}

model ItemImage {
  id        String   @id @default(cuid())
  itemId    String
  fileKey   String
  position  Int      @default(0)
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model ItemLink {
  id        String   @id @default(cuid())
  itemId    String
  url       String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model Reservation {
  id           String            @id @default(cuid())
  itemId       String            @unique
  reservedById String
  status       ReservationStatus @default(reserved)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  item       Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  reservedBy User @relation(fields: [reservedById], references: [id], onDelete: Cascade)

  @@index([reservedById])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  // Уникальность пары без учёта порядка обеспечивается в сервисе (всегда сортировать id)
  // и дополнительным индексом в миграции: LEAST/GREATEST.
  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model Group {
  id           String      @id @default(cuid())
  ownerId      String
  title        String
  description  String?
  budget       Decimal?    @db.Decimal(12, 2)
  currency     String?     @default("RUB")
  drawDate     DateTime?   @db.Date
  exchangeDate DateTime?   @db.Date
  status       GroupStatus @default(open)
  inviteCode   String      @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  owner       User             @relation(fields: [ownerId], references: [id])
  members     GroupMember[]
  exclusions  GroupExclusion[]
  assignments Assignment[]
}

model GroupMember {
  id         String   @id @default(cuid())
  groupId    String
  userId     String
  wishlistId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wishlist Wishlist? @relation(fields: [wishlistId], references: [id], onDelete: SetNull)

  @@unique([groupId, userId])
}

model GroupExclusion {
  id        String   @id @default(cuid())
  groupId   String
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userAId, userBId])
}

model Assignment {
  id         String   @id @default(cuid())
  groupId    String
  giverId    String
  receiverId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  giver    User  @relation("Giver", fields: [giverId], references: [id], onDelete: Cascade)
  receiver User  @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([groupId, giverId])
  @@unique([groupId, receiverId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
