# Скопируйте в .env: cp .env.example .env
NODE_ENV=development

# PostgreSQL (compose.dev.yml)
POSTGRES_USER=wishlist
POSTGRES_PASSWORD=wishlist
POSTGRES_DB=wishlist
POSTGRES_PORT=5433
DATABASE_URL=postgresql://wishlist:wishlist@localhost:5433/wishlist?schema=public

# pgAdmin (docker compose -f compose.dev.yml --profile tools up -d)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Бэкенд
SERVER_PORT=3000
# Необязательно. Для привязки API только к локальному интерфейсу задайте 127.0.0.1.
# SERVER_HOST=127.0.0.1
# Число прокси перед сервером: 0 локально, 1 за Caddy на сервере.
# Неверное значение позволяет подделать IP и обойти лимиты попыток входа.
TRUST_PROXY=0
CLIENT_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
UPLOADS_DIR=./uploads
SUPPORT_CONTACT_URL=https://t.me/your_support

# Администратор (npm run create-admin)
# Задайте свои значения: ник (латиница, 3–20 символов) и пароль от 12 символов,
# в котором есть строчные, заглавные буквы, цифры и символы. Примеры из репозитория не подходят.
# Ник админа не должен совпадать с ником обычного пользователя и не должен быть очевидным.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# OAuth (заполнить при реализации эпика 2)
TELEGRAM_BOT_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
