{
  "name": "quietharbor-wishlist",
  "private": true,
  "version": "0.2.1",
  "license": "MIT",
  "author": "Ilya Burlak (@Ilya_Burlak)",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev:db && npm run db:deploy && concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:db": "docker compose -f compose.dev.yml up -d --wait db",
    "dev:down": "docker compose -f compose.dev.yml down",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "dev:reset": "docker compose -f compose.dev.yml down -v && npm run dev:db && npm run db:deploy && npm run db:seed",
    "db:migrate": "npm run db:migrate -w server",
    "db:deploy": "npm run db:deploy -w server",
    "db:seed": "npm run db:seed -w server",
    "db:studio": "npm run db:studio -w server",
    "create-admin": "npm run create-admin -w server",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "reset-link": "npm run reset-link -w server --",
    "prod:build": "docker compose --env-file .env.production -f compose.prod.yml build",
    "prod:up": "docker compose --env-file .env.production -f compose.prod.yml up -d --build --wait",
    "prod:down": "docker compose --env-file .env.production -f compose.prod.yml down",
    "prod:migrate": "docker compose --env-file .env.production -f compose.prod.yml run --rm --build migrate",
    "prod:logs": "docker compose --env-file .env.production -f compose.prod.yml logs -f --tail=100",
    "prod:create-admin": "docker compose --env-file .env.production -f compose.prod.yml --profile tools run --rm create-admin",
    "prod:reset-link": "docker compose --env-file .env.production -f compose.prod.yml exec server node dist/scripts/create-reset-link.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "type": "module",
  "overrides": {
    "esbuild": "0.28.2",
    "effect": "^3.22.5",
    "deepmerge-ts": "^8.0.2"
  }
}
