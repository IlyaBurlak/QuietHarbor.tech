# Прод-настройки. Скопируйте в .env.production (в git он не попадает) и заполните:
#   cp .env.production.example .env.production
# Секреты генерируйте сами: openssl rand -hex 32

# --- Адрес сайта ---
# На сервере: домен без схемы, Caddy сам получит HTTPS-сертификат (DNS домена должен указывать на сервер).
# Для проверки на своём компьютере: SITE_ADDRESS=http://localhost, HTTP_PORT=8080, CLIENT_URL=http://localhost:8080
SITE_ADDRESS=example.com
CLIENT_URL=https://example.com
PUBLISH_HOST=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# --- База данных (наружу не публикуется) ---
POSTGRES_USER=wishlist
POSTGRES_PASSWORD=change-me-long-random-password
POSTGRES_DB=wishlist

# --- Бэкенд ---
SESSION_SECRET=change-me-openssl-rand-hex-32-at-least-32-chars
SUPPORT_CONTACT_URL=https://t.me/your_support

# --- Администратор (npm run prod:create-admin) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Вход через соцсети (эпик 2, заполнить при подключении) ---
TELEGRAM_BOT_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Резервные копии: установщик создаёт отдельные .env.backup и .env.backup-key.
# Расписание, часовой пояс и каталог копий выбираются в его меню.
